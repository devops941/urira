# ==========================================
# UYIRA - Git Ignore Configuration
# ==========================================

# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & Sensitive Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
*.pem
*.key
*.cert

# Build Outputs & Bundles
dist/
build/
*/dist/
*/build/
out/
.output/
web-build/

# Expo & Metro
.expo/
*/.expo/
.expo-shared/
*.metro-cache
.metro-health-check*

# React Native & Android / iOS
android/.gradle/
android/app/build/
android/build/
ios/Pods/
ios/build/
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision

# TypeScript
*.tsbuildinfo

# Cache & Temporary Files
.cache/
.parcel-cache/
.turbo/
.eslintcache
tmp/
temp/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo

